# Shopify Dev Dashboard -> Ayarlar -> Istemci kimligi / gizli anahtar
SHOPIFY_API_KEY=273f7ed2240241dab0ebf935ff2d77c0
SHOPIFY_API_SECRET=BURAYA_CLIENT_SECRET_GIR

# Yetkiler: read_products (urun okuma) + write_products (metafield yazma)
SCOPES=read_products,write_products

# Railway'den alinan uygulama adresi
HOST=https://shopifyapp1-production.up.railway.app

# Ayni deger SHOPIFY_API_KEY ile ayni olmali (panel derlenirken gomuluyor)
VITE_SHOPIFY_API_KEY=273f7ed2240241dab0ebf935ff2d77c0

# ZORUNLU: oturum deposu. Tanimsizsa oturumlar bellekte tutulur ve her
# yeniden baslatmada silinir — magazalarin belirteci kaybolur.
# Railway'de Postgres eklendiginde referansla verin: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

NODE_ENV=production
PORT=3000
