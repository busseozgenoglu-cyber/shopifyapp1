# Shopify Partner panelinden alinan degerler
SHOPIFY_API_KEY=BURAYA_CLIENT_ID_GIR
SHOPIFY_API_SECRET=BURAYA_CLIENT_SECRET_GIR

# Yetkiler: read_products (urun okuma) + write_products (metafield yazma)
SCOPES=read_products,write_products

# Railway'den alinan domain: https://convertflow-tr-production.up.railway.app
HOST=https://BURAYA_ADRES_GIR.up.railway.app

# Ayni deger SHOPIFY_API_KEY ile ayni olmali
VITE_SHOPIFY_API_KEY=BURAYA_CLIENT_ID_GIR

NODE_ENV=production
PORT=3000
