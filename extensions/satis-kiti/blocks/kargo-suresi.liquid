{%- comment -%}
  Satış Kiti — Kargo Kesim Saati Sayaci + Gercek Stok Bilgisi
  Sahte "su an X kisi bakiyor" sayaci bilerek konmadi: uydurma veridir,
  tuketiciyi yaniltir ve Shopify incelemesinde ret sebebidir.
{%- endcomment -%}

{%- liquid
  assign lisans = app.metafields.convertflow.aktif
  assign kapali = false
  if lisans != blank and lisans == '0'
    assign kapali = true
  endif
  assign secili = product.selected_or_first_available_variant
-%}

{%- unless kapali -%}
{%- if product != blank -%}
<div
  class="cf-aciliyet"
  data-sk-aciliyet
  data-kesim-saati="{{ block.settings.kesim_saati }}"
  data-mesaj="{{ block.settings.kargo_mesaji | escape }}"
  data-son-mesaj="{{ block.settings.gecti_mesaji | escape }}"
  style="--cf-vurgu: {{ block.settings.vurgu_rengi }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.kargo_sayaci -%}
    <p class="cf-aciliyet__kargo" data-sk-aciliyet-mesaj>{{ block.settings.kargo_mesaji }}</p>
  {%- endif -%}

  {%- if block.settings.stok_goster -%}
    {%- if secili.inventory_management != blank and secili.inventory_policy == 'deny' -%}
      {%- assign stok = secili.inventory_quantity -%}
      {%- if stok > 0 and stok <= block.settings.stok_esigi -%}
        <div class="cf-aciliyet__stok">
          <span class="cf-aciliyet__stok-nokta"></span>
          <span class="cf-aciliyet__stok-metin">
            {{ block.settings.stok_mesaji | replace: '[adet]', stok }}
          </span>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
</div>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Kargo Saati & Stok",
  "target": "section",
  "stylesheet": "convertflow.css",
  "javascript": "convertflow.js",
  "settings": [
    { "type": "header", "content": "Kargo kesim saati" },
    { "type": "checkbox", "id": "kargo_sayaci", "label": "Kargo sayacını göster", "default": true },
    {
      "type": "text",
      "id": "kesim_saati",
      "label": "Kargo kesim saati",
      "default": "16:00",
      "info": "24 saat biçiminde. Bu saatten önce verilen siparişler aynı gün kargolanıyorsa."
    },
    {
      "type": "text",
      "id": "kargo_mesaji",
      "label": "Kargo mesajı",
      "default": "Bugün kargoda: [saat]sa [dakika]dk kaldı",
      "info": "[saat], [dakika], [sure] yer tutucuları kullanılabilir. Kamyon simgesi otomatik eklenir, metne ayrıca eklemeyin."
    },
    {
      "type": "text",
      "id": "gecti_mesaji",
      "label": "Kesim saati geçti mesajı",
      "default": "Bugünkü kargo kesim saati doldu, yarın kargolanacak"
    },
    { "type": "header", "content": "Stok uyarısı" },
    { "type": "checkbox", "id": "stok_goster", "label": "Stok uyarısı göster", "default": true },
    {
      "type": "number",
      "id": "stok_esigi",
      "label": "Stok eşik değeri",
      "default": 10,
      "info": "Bu değerin altındaki stoklarda uyarı gösterilir."
    },
    {
      "type": "text",
      "id": "stok_mesaji",
      "label": "Stok mesajı",
      "default": "🔥 Stokta sadece [adet] adet kaldı!",
      "info": "[adet] yerine gerçek stok adedi yazılır."
    },
    {
      "type": "color",
      "id": "vurgu_rengi",
      "label": "Vurgu rengi",
      "default": "#F59E0B"
    }
  ]
}
{% endschema %}
