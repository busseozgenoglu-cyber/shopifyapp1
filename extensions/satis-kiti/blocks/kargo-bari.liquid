{%- comment -%}
  Satış Kiti — Ücretsiz Kargo İlerleme Çubuğu
  Sepet tutarini Shopify'in kendi cart nesnesinden okur.
  Sepet guncellendiginde /cart.js ile yenilenir — dis servis yok.
{%- endcomment -%}

{%- liquid
  assign lisans = app.metafields.convertflow.aktif
  assign kapali = false
  if lisans != blank and lisans == '0'
    assign kapali = true
  endif

  assign esik = block.settings.esik
  assign toplam = cart.total_price
  assign kalan = esik | minus: toplam
  assign yuzde = 0
  if esik > 0
    assign yuzde = toplam | times: 100 | divided_by: esik
  endif
  if yuzde > 100
    assign yuzde = 100
  endif
  assign kalan_para = kalan | money
-%}

{%- unless kapali -%}
<div
  class="cf-kargo"
  data-sk-kargo
  data-esik="{{ esik }}"
  data-para-formati="{{ shop.money_format | escape }}"
  data-mesaj-devam="{{ block.settings.mesaj_devam | escape }}"
  data-mesaj-tamam="{{ block.settings.mesaj_tamam | escape }}"
  style="--cf-vurgu: {{ block.settings.bar_rengi }};"
  {{ block.shopify_attributes }}
>
  <p class="cf-kargo__mesaj" data-sk-kargo-mesaj>
    {%- if kalan > 0 -%}
      {{ block.settings.mesaj_devam | replace: '[tutar]', kalan_para }}
    {%- else -%}
      {{ block.settings.mesaj_tamam }}
    {%- endif -%}
  </p>

  <div class="cf-kargo__ray" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ yuzde }}" data-sk-kargo-ray>
    <div class="cf-kargo__dolgu" data-sk-kargo-dolgu style="width: {{ yuzde }}%"></div>
  </div>

  <p class="cf-kargo__yuzde">{{ yuzde }}% tamamlandı</p>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Ücretsiz Kargo Çubuğu",
  "target": "section",
  "stylesheet": "convertflow.css",
  "javascript": "convertflow.js",
  "settings": [
    {
      "type": "number",
      "id": "esik",
      "label": "Ücretsiz kargo alt sınırı (kuruş)",
      "default": 75000,
      "info": "75000 = 750 ₺. Mağaza kargo ayarındaki tutarla aynı olmalı."
    },
    {
      "type": "text",
      "id": "mesaj_devam",
      "label": "Sınıra ulaşılmadığında mesaj",
      "default": "Ücretsiz kargoya [tutar] kaldı! 🎁",
      "info": "[tutar] yerine kalan tutar yazılır."
    },
    {
      "type": "text",
      "id": "mesaj_tamam",
      "label": "Sınıra ulaşıldığında mesaj",
      "default": "🎉 Tebrikler! Ücretsiz kargo hakkın kazandın!"
    },
    {
      "type": "color",
      "id": "bar_rengi",
      "label": "İlerleme çubuğu rengi",
      "default": "#10B981"
    }
  ]
}
{% endschema %}
