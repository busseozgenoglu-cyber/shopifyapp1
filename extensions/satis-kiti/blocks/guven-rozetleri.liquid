{%- comment -%}
  Satış Kiti — Güven Rozetleri
  Tamamen statik — magazanin gercekten sundugu hizmetleri yazmalisin.
  Sahte rozetler Shopify incelemesinde ret sebebidir.
{%- endcomment -%}

{%- liquid
  assign lisans = app.metafields.convertflow.aktif
  assign kapali = false
  if lisans != blank and lisans == '0'
    assign kapali = true
  endif
-%}

{%- unless kapali -%}
<div class="cf-rozetler" style="--cf-vurgu: {{ block.settings.ikon_rengi }};" {{ block.shopify_attributes }}>
  {%- if block.settings.rozet_1 != blank -%}
    <div class="cf-rozet">
      <span class="cf-rozet__ikon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>
        </svg>
      </span>
      <span class="cf-rozet__metin">{{ block.settings.rozet_1 }}</span>
    </div>
  {%- endif -%}

  {%- if block.settings.rozet_2 != blank -%}
    <div class="cf-rozet">
      <span class="cf-rozet__ikon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 7h13v9H1z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>
        </svg>
      </span>
      <span class="cf-rozet__metin">{{ block.settings.rozet_2 }}</span>
    </div>
  {%- endif -%}

  {%- if block.settings.rozet_3 != blank -%}
    <div class="cf-rozet">
      <span class="cf-rozet__ikon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
        </svg>
      </span>
      <span class="cf-rozet__metin">{{ block.settings.rozet_3 }}</span>
    </div>
  {%- endif -%}

  {%- if block.settings.rozet_4 != blank -%}
    <div class="cf-rozet">
      <span class="cf-rozet__ikon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </span>
      <span class="cf-rozet__metin">{{ block.settings.rozet_4 }}</span>
    </div>
  {%- endif -%}

  {%- if block.settings.rozet_5 != blank -%}
    <div class="cf-rozet">
      <span class="cf-rozet__ikon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
      </span>
      <span class="cf-rozet__metin">{{ block.settings.rozet_5 }}</span>
    </div>
  {%- endif -%}
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Güven Rozetleri",
  "target": "section",
  "stylesheet": "convertflow.css",
  "javascript": "convertflow.js",
  "settings": [
    {
      "type": "text",
      "id": "rozet_1",
      "label": "Rozet 1",
      "default": "✓ Kapıda Ödeme"
    },
    {
      "type": "text",
      "id": "rozet_2",
      "label": "Rozet 2",
      "default": "✓ 14 Gün İade"
    },
    {
      "type": "text",
      "id": "rozet_3",
      "label": "Rozet 3",
      "default": "✓ Güvenli Ödeme"
    },
    {
      "type": "text",
      "id": "rozet_4",
      "label": "Rozet 4",
      "default": "✓ Hızlı Kargo"
    },
    {
      "type": "text",
      "id": "rozet_5",
      "label": "Rozet 5 (opsiyonel)",
      "default": "✓ Müşteri Desteği"
    },
    {
      "type": "color",
      "id": "ikon_rengi",
      "label": "İkon rengi",
      "default": "#4F46E5"
    }
  ]
}
{% endschema %}
