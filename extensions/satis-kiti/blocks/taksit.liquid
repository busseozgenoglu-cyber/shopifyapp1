{%- comment -%}
  Satış Kiti — Taksit Tablosu
  Urun fiyatini taksit planina boler. Varyant degisince tutar aninda guncellenir.
  Hicbir dis servise baglanmaz. Tum veri Shopify'in kendi nesnelerinden gelir.
{%- endcomment -%}

{%- liquid
  assign lisans = app.metafields.convertflow.aktif
  assign kapali = false
  if lisans != blank and lisans == '0'
    assign kapali = true
  endif
-%}

{%- unless kapali -%}
{%- if product != blank -%}
  {%- assign secili = product.selected_or_first_available_variant -%}
  {%- assign fiyat = secili.price -%}

  {%- if fiyat >= block.settings.alt_limit -%}
    {%- assign plan_satirlari = block.settings.taksit_plani | split: ',' -%}

    <div
      class="cf-taksit"
      data-sk-taksit
      data-urun="{{ product.handle }}"
      data-fiyat="{{ fiyat }}"
      data-plan="{{ block.settings.taksit_plani | escape }}"
      data-alt-limit="{{ block.settings.alt_limit }}"
      data-min-taksit-tutari="{{ block.settings.min_taksit_tutari }}"
      data-para-formati="{{ shop.money_format | escape }}"
      data-vade-etiketi="{{ block.settings.vade_farksiz_etiketi | escape }}"
      data-taksit-kelimesi="{{ block.settings.taksit_kelimesi | escape }}"
      style="--cf-vurgu: {{ block.settings.vurgu_rengi }};"
      {{ block.shopify_attributes }}
    >
      <div class="cf-taksit__baslik">
        <span class="cf-taksit__ikon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M7 15h.01"/><path d="M12 15h.01"/><path d="M17 15h.01"/>
          </svg>
        </span>
        <span>{{ block.settings.baslik }}</span>
      </div>

      <table class="cf-taksit__tablo">
        <thead>
          <tr>
            <th scope="col">{{ block.settings.sutun_taksit }}</th>
            <th scope="col">{{ block.settings.sutun_aylik }}</th>
            <th scope="col">{{ block.settings.sutun_toplam }}</th>
          </tr>
        </thead>
        <tbody data-sk-taksit-govde>
          {% for vade in plan_satirlari %}
            {%- assign vade_sayi = vade | strip | plus: 0 -%}
            {%- if vade_sayi > 0 -%}
              <tr>
                <td>{{ vade_sayi }} {{ block.settings.taksit_kelimesi }}</td>
                <td><strong>{{ fiyat | divided_by: vade_sayi | money }}</strong></td>
                <td>{{ fiyat | money }}</td>
              </tr>
            {%- endif -%}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {%- endif -%}
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Taksit Tablosu",
  "target": "section",
  "stylesheet": "convertflow.css",
  "javascript": "convertflow.js",
  "settings": [
    {
      "type": "text",
      "id": "baslik",
      "label": "Başlık",
      "default": "Taksit Seçenekleri"
    },
    {
      "type": "text",
      "id": "taksit_plani",
      "label": "Taksit planı (vade sayıları, virgülle)",
      "default": "3,6,9,12",
      "info": "Örnek: 3,6,9,12"
    },
    {
      "type": "number",
      "id": "alt_limit",
      "label": "Minimum fiyat (kuruş)",
      "default": 10000,
      "info": "Bu fiyatın altındaki ürünlerde taksit tablosu gösterilmez. 10000 = 100 ₺"
    },
    {
      "type": "number",
      "id": "min_taksit_tutari",
      "label": "Minimum aylık taksit (kuruş)",
      "default": 100,
      "info": "Bu tutarın altındaki taksitler gösterilmez."
    },
    {
      "type": "text",
      "id": "taksit_kelimesi",
      "label": "Taksit kelimesi",
      "default": "taksit"
    },
    {
      "type": "text",
      "id": "vade_farksiz_etiketi",
      "label": "Vade farksız etiketi",
      "default": "Vade farksız",
      "info": "Aylık tutar × vade = ürün fiyatı ise bu etiket gösterilir."
    },
    {
      "type": "text",
      "id": "sutun_taksit",
      "label": "Taksit sütun başlığı",
      "default": "Taksit"
    },
    {
      "type": "text",
      "id": "sutun_aylik",
      "label": "Aylık sütun başlığı",
      "default": "Aylık"
    },
    {
      "type": "text",
      "id": "sutun_toplam",
      "label": "Toplam sütun başlığı",
      "default": "Toplam"
    },
    {
      "type": "color",
      "id": "vurgu_rengi",
      "label": "Vurgu rengi",
      "default": "#4F46E5"
    }
  ]
}
{% endschema %}
