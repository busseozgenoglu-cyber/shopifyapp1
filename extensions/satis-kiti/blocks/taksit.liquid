{%- comment -%}
  Taksit tablosu — ürün fiyatını taksit planına böler.
  Fiyat Shopify'dan gelir, hiçbir dış servise istek atılmaz.
{%- endcomment -%}

{%- liquid
  assign lisans = app.metafields.satiskiti.aktif
  assign kapali = false
  if lisans != blank and lisans == '0'
    assign kapali = true
  endif
-%}

{%- unless kapali -%}
{%- if product != blank -%}
  {%- assign secili = product.selected_or_first_available_variant -%}
  {%- assign fiyat = secili.price -%}

  {%- if fiyat >= block.settings.alt_limit -%}
    {%- assign plan_satirlari = block.settings.taksit_plani | split: ',' -%}

    <div
      class="sk-taksit"
      data-sk-taksit
      data-urun="{{ product.handle }}"
      data-fiyat="{{ fiyat }}"
      data-plan="{{ block.settings.taksit_plani | escape }}"
      data-alt-limit="{{ block.settings.alt_limit }}"
      data-min-taksit="{{ block.settings.min_taksit_tutari }}"
      data-para-formati="{{ shop.money_format | escape }}"
      data-vade-etiketi="{{ block.settings.vade_farksiz_etiketi | escape }}"
      data-taksit-kelimesi="{{ block.settings.taksit_kelimesi | escape }}"
      style="--sk-vurgu: {{ block.settings.vurgu_rengi }}; --sk-kenar: {{ block.settings.kenarlik_rengi }};"
      {{ block.shopify_attributes }}
    >
      <div class="sk-taksit__baslik">
        <span class="sk-taksit__ikon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>
          </svg>
        </span>
        <span>{{ block.settings.baslik }}</span>
      </div>

      <table class="sk-taksit__tablo">
        <thead>
          <tr>
            <th scope="col">{{ block.settings.sutun_taksit }}</th>
            <th scope="col">{{ block.settings.sutun_aylik }}</th>
            <th scope="col">{{ block.settings.sutun_toplam }}</th>
          </tr>
        </thead>
        <tbody data-sk-taksit-govde>
          {%- for satir in plan_satirlari -%}
            {%- assign parcalar = satir | split: ':' -%}
            {%- assign adet = parcalar[0] | strip | plus: 0 -%}
            {%- assign oran = 0 -%}
            {%- if parcalar.size > 1 -%}
              {%- assign oran = parcalar[1] | strip | times: 1.0 -%}
            {%- endif -%}

            {%- if adet > 1 -%}
              {%- assign vade_farki = fiyat | times: oran | divided_by: 100.0 -%}
              {%- assign toplam = fiyat | plus: vade_farki | round -%}
              {%- assign aylik = toplam | divided_by: adet | round -%}

              {%- if aylik >= block.settings.min_taksit_tutari -%}
                <tr>
                  <td>
                    <strong>{{ adet }}</strong> {{ block.settings.taksit_kelimesi }}
                    {%- if oran == 0 %} <span class="sk-taksit__rozet">{{ block.settings.vade_farksiz_etiketi }}</span>{% endif -%}
                  </td>
                  <td class="sk-taksit__aylik">{{ aylik | money }}</td>
                  <td class="sk-taksit__toplam">{{ toplam | money }}</td>
                </tr>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>

      {%- if block.settings.dipnot != blank -%}
        <p class="sk-taksit__dipnot">{{ block.settings.dipnot }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Taksit tablosu",
  "target": "section",
  "stylesheet": "satiskiti.css",
  "javascript": "satiskiti.js",
  "settings": [
    {
      "type": "header",
      "content": "Taksit planı"
    },
    {
      "type": "text",
      "id": "taksit_plani",
      "label": "Taksit planı",
      "default": "3:0, 6:0, 9:4.5, 12:8",
      "info": "Biçim: taksit:vade farkı yüzdesi. Örnek '3:0, 6:0, 9:4.5, 12:8' → 3 ve 6 taksit vade farksız, 9 taksitte %4.5, 12 taksitte %8 fark. Oranları bankanın POS sözleşmenden al."
    },
    {
      "type": "text",
      "id": "baslik",
      "label": "Başlık",
      "default": "Taksit Seçenekleri"
    },
    {
      "type": "text",
      "id": "taksit_kelimesi",
      "label": "Taksit kelimesi",
      "default": "Taksit"
    },
    {
      "type": "text",
      "id": "vade_farksiz_etiketi",
      "label": "Vade farksız etiketi",
      "default": "Vade farksız"
    },
    {
      "type": "header",
      "content": "Görünme kuralları"
    },
    {
      "type": "number",
      "id": "alt_limit",
      "label": "Ürün fiyatı bu tutarın altındaysa gösterme (kuruş)",
      "default": 50000,
      "info": "50000 = 500 ₺. Shopify tutarları kuruş cinsinden tutar."
    },
    {
      "type": "number",
      "id": "min_taksit_tutari",
      "label": "Aylık taksit bu tutarın altına düşerse satırı gizle (kuruş)",
      "default": 10000,
      "info": "10000 = 100 ₺. Bankalar genelde çok küçük taksitlere izin vermez."
    },
    {
      "type": "header",
      "content": "Tablo başlıkları"
    },
    { "type": "text", "id": "sutun_taksit", "label": "1. sütun", "default": "Taksit" },
    { "type": "text", "id": "sutun_aylik", "label": "2. sütun", "default": "Aylık ödeme" },
    { "type": "text", "id": "sutun_toplam", "label": "3. sütun", "default": "Toplam" },
    {
      "type": "textarea",
      "id": "dipnot",
      "label": "Dipnot",
      "default": "Taksit seçenekleri kartınızın bankasına göre değişebilir. Kesin tutar ödeme adımında görünür."
    },
    {
      "type": "header",
      "content": "Görünüm"
    },
    { "type": "color", "id": "vurgu_rengi", "label": "Vurgu rengi", "default": "#1a7f5a" },
    { "type": "color", "id": "kenarlik_rengi", "label": "Kenarlık rengi", "default": "#e3e3e3" }
  ]
}
{% endschema %}
